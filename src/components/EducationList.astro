---
import type { EducationItem } from '../data/resume';
interface Props { items: EducationItem[]; }
const { items } = Astro.props;
const statusLabel = { completado: 'Completado', 'en-curso': 'En curso' };
---
<ul class="edu-list">
  {items.map(item => (
    <li class="edu-item">
      <div class="edu-header">
        <h3>{item.degree}</h3>
        <span class="status">{statusLabel[item.status]}</span>
      </div>
      <p class="institution">{item.institution}</p>
      <p class="dates">{item.startDate} — {item.endDate}</p>
    </li>
  ))}
</ul>

<style lang="scss">
  .edu-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .edu-item { padding: 1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.6rem; }
  .edu-header {
    display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;
    h3 { margin: 0; font-size: 1rem; }
  }
  .status {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--color-accent); border: 1px solid var(--color-accent);
    border-radius: 999px; padding: 0.1rem 0.5rem; white-space: nowrap;
  }
  .institution { margin: 0.3rem 0 0.15rem; opacity: 0.85; font-size: 0.9rem; }
  .dates { margin: 0; font-size: 0.8rem; opacity: 0.55; }
</style>