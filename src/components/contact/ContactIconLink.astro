---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  icon: string;
  href: string;
  accent: string;
}
const { label, icon, href, accent } = Astro.props;
---
<a
  class="contact-link"
  href={href}
  style={`--accent:${accent}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <span class="glow"></span>
  <Icon name={icon} class="icon" />
  <span class="label">{label}</span>
</a>

<style lang="scss">
  .contact-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: #050506;
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.2s ease, border-color 0.2s ease;

    &:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      .glow { opacity: 0.7; }
    }
  }

  .glow {
    position: absolute;
    inset: -40%;
    background: radial-gradient(circle, var(--accent) 0%, transparent 60%);
    filter: blur(40px);
    opacity: 0.35;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .icon {
    position: relative;
    z-index: 1;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--accent);
  }

  .label {
    position: relative;
    z-index: 1;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>