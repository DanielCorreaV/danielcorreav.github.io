---
import type { SkillGroup } from '../data/resume';
interface Props { groups: SkillGroup[]; }
const { groups } = Astro.props;
---
<div class="skills-grid">
  {groups.map(g => (
    <div class="skill-group">
      <h3>{g.category}</h3>
      <div class="skill-tags">
        {g.skills.map(s => <span class="skill-tag">{s}</span>)}
      </div>
    </div>
  ))}
</div>

<style lang="scss">
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
  .skill-group h3 { margin: 0 0 0.75rem; font-size: 0.95rem; opacity: 0.8; }
  .skill-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .skill-tag {
    font-size: 0.8rem; padding: 0.3rem 0.75rem; border-radius: 999px;
    border: 1px solid var(--color-border); transition: border-color 0.2s ease;
    &:hover { border-color: var(--color-accent); }
  }
</style>