---
interface Screenshot { src: string; alt: string; }
interface Props { screenshots: Screenshot[]; }
const { screenshots } = Astro.props;
---
<div class="coverflow">
  <div class="stage">
    <ul class="track" role="list">
      {screenshots.map((s, i) => (
        <li class="card" data-index={i}>
          <button type="button" class="card-trigger">
            <img src={s.src} alt={s.alt} loading="lazy" />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="controls">
    <button class="nav prev" aria-label="Captura anterior">‹</button>
    <ul class="dots" role="tablist">
      {screenshots.map((_, i) => (
        <li><button class:list={['dot', { active: i === 0 }]} data-index={i} aria-label={`Ir a captura ${i + 1}`}></button></li>
      ))}
    </ul>
    <button class="nav next" aria-label="Siguiente captura">›</button>
  </div>
</div>

<div id="lightbox" class="lightbox" hidden>
  <button class="lightbox-close" aria-label="Cerrar">✕</button>
  <button class="lightbox-nav prev" aria-label="Anterior" data-dir="-1">‹</button>
  <img id="lightbox-img" src="" alt="" />
  <button class="lightbox-nav next" aria-label="Siguiente" data-dir="1">›</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.coverflow').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.card'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const prevBtn = root.querySelector<HTMLButtonElement>('.nav.prev')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.nav.next')!;
    const triggers = cards.map(c => c.querySelector<HTMLButtonElement>('.card-trigger')!);
    const images = triggers.map(t => t.querySelector('img')!.src);
    const total = cards.length;

    let current = 0;

    // Distancia circular más corta entre "index" y "current" — puede ser negativa
    // (hacia la izquierda) o positiva (hacia la derecha), lo que sea más cercano.
    function circularOffset(index: number, from: number): number {
      let offset = index - from;
      if (offset > total / 2) offset -= total;
      if (offset < -total / 2) offset += total;
      return offset;
    }

    function layout() {
      const cardWidth = cards[0]?.getBoundingClientRect().width ?? 300;
      const spacing = cardWidth * 0.62;

      cards.forEach((card, i) => {
        const offset = circularOffset(i, current);
        const abs = Math.abs(offset);

        if (abs > 2) {
          card.style.opacity = '0';
          card.style.pointerEvents = 'none';
          return;
        }

        const x = offset * spacing;
        const scale = Math.max(1 - abs * 0.18, 0.55);
        const rotate = Math.max(-1, Math.min(1, offset)) * -32 * Math.min(abs, 1);
        const opacity = offset === 0 ? 1 : abs === 1 ? 0.6 : 0.3;

        card.style.transform = `translate(-50%, -50%) translateX(${x}px) scale(${scale}) rotateY(${rotate}deg)`;
        card.style.zIndex = String(100 - abs);
        card.style.opacity = String(opacity);
        card.style.pointerEvents = 'auto';
        card.classList.toggle('is-active', offset === 0);
      });

      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    // Módulo "seguro" — en JS, -1 % n da negativo, esto lo corrige para que siempre
    // quede en el rango [0, total). Así es como se logra el bucle.
    function goTo(index: number) {
      current = ((index % total) + total) % total;
      layout();
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', () => {
        if (i === current) {
          openLightbox(i);
        } else {
          goTo(i);
        }
      });
    });

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));
    dots.forEach(dot => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));

    window.addEventListener('resize', layout);
    layout();

    // Lightbox
    const lightbox = document.getElementById('lightbox')!;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    let lbIndex = 0;

    function openLightbox(index: number) {
      lbIndex = index;
      lightboxImg.src = images[lbIndex];
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }
    function showLightboxIndex(delta: number) {
      lbIndex = (lbIndex + delta + images.length) % images.length;
      lightboxImg.src = images[lbIndex];
    }

    lightbox.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
    lightbox.querySelectorAll<HTMLButtonElement>('.lightbox-nav').forEach(btn => {
      btn.addEventListener('click', () => showLightboxIndex(Number(btn.dataset.dir)));
    });
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showLightboxIndex(-1);
      if (e.key === 'ArrowRight') showLightboxIndex(1);
    });
  });
</script>

<style lang="scss">
  .coverflow { --card-w: min(420px, 62vw); --card-h: calc(var(--card-w) * 10 / 16); }

  .stage {
    position: relative;
    height: calc(var(--card-h) + 1.5rem);
    perspective: 1400px;
    margin-bottom: 1.25rem;
  }

  .track { list-style: none; margin: 0; padding: 0; height: 100%; }

  .card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-w);
    height: var(--card-h);
    transition: transform 0.4s ease, opacity 0.4s ease;
    will-change: transform, opacity;
  }

  .card-trigger {
    display: block;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: border-color 0.2s ease;

    img { width: 100%; height: 100%; object-fit: cover; display: block; }
  }

  .card.is-active .card-trigger {
    border-color: var(--color-accent);
    cursor: zoom-in;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .nav {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    &:hover:not(:disabled) { border-color: var(--color-accent); }
    &:disabled { opacity: 0.3; cursor: default; }
  }

  .dots {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dot {
    width: 7px; height: 7px; border-radius: 50%; border: none; padding: 0;
    background: var(--color-border); cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    &.active { background: var(--color-accent); transform: scale(1.3); }
  }

  .lightbox {
    position: fixed; inset: 0; z-index: 100;
    background: rgba(0, 0, 0, 0.9);
    display: flex; align-items: center; justify-content: center;
    padding: 2rem;

    &[hidden] { display: none; }

    img { max-width: 100%; max-height: 100%; border-radius: 0.5rem; }
  }
  .lightbox-close {
    position: absolute; top: 1.5rem; right: 1.5rem;
    width: 2.5rem; height: 2.5rem; border-radius: 50%; border: none;
    background: rgba(255,255,255,0.1); color: #fff; font-size: 1.1rem; cursor: pointer;
    &:hover { background: rgba(255,255,255,0.2); }
  }
  .lightbox-nav {
    position: absolute; top: 50%; 
    transform: translateY(-50%);
    width: 2.75rem; 
    height: 2.75rem; 
    border-radius: 50%; 
    border: none;
    background: #515151bf; 
    color: #fff; 
    font-size: 1.3rem; cursor: pointer;
    &:hover { background: #7c7a7abf }
    &.prev { left: 1.5rem; }
    &.next { right: 1.5rem; }
  }
</style>