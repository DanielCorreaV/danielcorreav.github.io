---
interface Props {
  accent: string;
  label: string;  // ej. la tecnología principal del proyecto
  seed?: string;  // normalmente el slug — varía el patrón de forma estable entre builds
}
const { accent, label, seed = label } = Astro.props;

// Hash simple y determinístico: mismo seed → siempre el mismo patrón,
// así el banner no "salta" visualmente entre despliegues.
function hashToUnit(str: string, salt: number): number {
  let h = salt;
  for (let i = 0; i < str.length; i++) {
    h = (h * 31 + str.charCodeAt(i)) >>> 0;
  }
  return (h % 1000) / 1000;
}

const x1 = 15 + hashToUnit(seed, 1) * 40;
const y1 = 10 + hashToUnit(seed, 2) * 40;
const x2 = 55 + hashToUnit(seed, 3) * 35;
const y2 = 55 + hashToUnit(seed, 4) * 35;
---
<div class="generated-cover" style={`--accent:${accent}; --x1:${x1}%; --y1:${y1}%; --x2:${x2}%; --y2:${y2}%;`}>
  <span class="label">{label}</span>
</div>

<style lang="scss">
  .generated-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #050506;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    border-radius: inherit;

    &::before {
      content: '';
      position: absolute;
      inset: -20%;
      background:
        radial-gradient(circle at var(--x1) var(--y1), var(--accent) 0%, transparent 42%),
        radial-gradient(circle at var(--x2) var(--y2), var(--accent) 0%, transparent 38%);
      filter: blur(35px);
      opacity: 0.55;
    }
  }

  .label {
    position: relative;
      z-index: 1;
     font-size: 1.1rem;
     font-weight: 800;
     letter-spacing: -0.01em;
     line-height: 1.3;
     color: #fff;
  }
</style>