---
interface Props {
  index: number;
  title: string;
  tagline: string;
  tag: string;
  accent: string;
  href: string;
  tags?: string;
  cover?: string;
}
const { index, title, tagline, tag, accent, href, tags, cover } = Astro.props;
const num = String(index).padStart(2, '0');
---
<a
  class:list={['project-card', { 'has-cover': cover }]}
  href={href}
  style={`--accent: ${accent};`}
  data-project-tags={tags}
>
  {cover
    ? <img src={cover} alt={`Portada de ${title}`} class="cover" loading="lazy" decoding="async" />
    : <div class="glow"></div>}
  <div class="shade"></div>
  <span class="index">{num}</span>
  <span class="tag">{tag}</span>
  <div class="footer">
    <h3>{title}</h3>
    <p>{tagline}</p>
    <span class="link">Ver proyecto →</span>
  </div>
</a>

<style lang="scss">
  .project-card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #050506;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: #fff;
    isolation: isolate;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;

    &:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 20px 40px -20px var(--accent);
      .glow { opacity: 0.85; transform: scale(1.1); }
      .cover { transform: scale(1.06); }
      .link { opacity: 1; transform: translateX(0); }
    }
  }

  // imagen de portada
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    transition: transform 0.5s ease;
  }

  // brillo de respaldo cuando no hay portada
  .glow {
    position: absolute;
    inset: -30%;
    background:
      radial-gradient(circle at 30% 25%, var(--accent) 0%, transparent 45%),
      radial-gradient(circle at 75% 70%, var(--accent) 0%, transparent 40%);
    filter: blur(50px);
    opacity: 0.55;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 0;
  }

  // oscurece arriba y abajo para que el texto se lea sobre cualquier imagen
  .shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      transparent 25%,
      transparent 45%,
      rgba(0, 0, 0, 0.88) 100%
    );
  }

  .index {
    position: absolute;
    top: 1rem;
    right: 1.1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    z-index: 2;
  }

  .tag {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    z-index: 2;
  }

  .footer {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    padding: 1.25rem;

    h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }
    p { margin: 0; font-size: 0.85rem; color: rgba(255, 255, 255, 0.78); }

    .link {
      display: inline-block;
      margin-top: 0.6rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
  }

  // en pantallas táctiles no hay hover: el enlace se ve siempre
  @media (hover: none) {
    .footer .link { opacity: 1; transform: none; }
  }
</style>