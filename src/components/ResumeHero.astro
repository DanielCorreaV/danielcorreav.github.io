---
import { profile } from '../data/resume';
---
<section class="resume-hero">
  <img src={profile.photo} alt={profile.fullName} class="avatar" />
  <div class="hero-text">
    <h1>{profile.fullName}</h1>
    <p class="role">{profile.role}</p>
    <p class="summary">{profile.summary}</p>
    <p class="location">📍 {profile.location}</p>
    <div class="actions">
      <a href={profile.cvUrl} class="btn-primary" download>Descargar CV (PDF)</a>
      <a href="/contacto" class="btn-secondary">Contactarme</a>
    </div>
  </div>
</section>

<style lang="scss">
  .resume-hero {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding-block: 3rem 2rem;
    flex-wrap: wrap;
  }
  .avatar {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }
  .hero-text { flex: 1; min-width: 240px; }
  h1 { margin: 0 0 0.25rem; font-size: 2rem; }
  .role { margin: 0 0 0.75rem; color: var(--color-accent); font-weight: 600; }
  .summary { margin: 0 0 0.5rem; opacity: 0.8; max-width: 55ch; line-height: 1.6; }
  .location { margin: 0 0 1.25rem; font-size: 0.85rem; opacity: 0.6; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn-primary, .btn-secondary {
    display: inline-block;
    padding: 0.6rem 1.3rem;
    border-radius: 0.4rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .btn-primary { background: var(--color-accent); color: #fff; &:hover { opacity: 0.85; } }
  .btn-secondary { border: 1px solid var(--color-border); color: var(--color-text); &:hover { border-color: var(--color-accent); } }
</style>