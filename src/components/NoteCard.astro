---
interface Props { title: string; description: string; pubDate: Date; tags: string[]; href: string; }
const { title, description, pubDate, tags, href } = Astro.props;
const formatter = new Intl.DateTimeFormat('es', { day: '2-digit', month: 'short', year: 'numeric' });
---
<a class="note-card" href={href}>
  <div class="note-header">
    <span class="note-date">{formatter.format(pubDate)}</span>
    <div class="note-tags">
      {tags.map(t => <span class="tech-tag">{t}</span>)}
    </div>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style lang="scss">
  .note-card {
    display: block; padding: 1.25rem; border: 1px solid var(--color-border);
    border-radius: 0.6rem; text-decoration: none; color: inherit;
    transition: border-color 0.2s ease;
    &:hover { border-color: var(--color-accent); }
  }
  .note-header { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .note-date { font-size: 0.75rem; opacity: 0.5; }
  .note-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tech-tag { font-size: 0.7rem; padding: 0.1rem 0.5rem; border-radius: 999px; background: var(--color-border); opacity: 0.85; }
  h3 { margin: 0 0 0.4rem; font-size: 1rem; }
  p { margin: 0; font-size: 0.85rem; opacity: 0.75; }
</style>