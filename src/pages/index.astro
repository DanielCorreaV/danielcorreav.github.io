---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementBanner from '../components/home/AnnouncementBanner.astro';
import FeaturedProjectCard from '../components/projects/FeaturedProjectCard.astro';
import ActivityTimeline from '../components/home/ActivityTimeline.astro';
import { projects } from '../data/projects';

const announcements = await getCollection('announcements');
const sortedAnnouncements = announcements.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestAnnouncement = sortedAnnouncements[0];
const pastAnnouncements = sortedAnnouncements.slice(1, 6); // próximas 5 más recientes

// const featuredProjects = [
//   { title: 'Proyecto Uno', tagline: 'Breve descripción del proyecto.', tag: 'Web App', accent: '#4f8cff', href: '/proyectos/proyecto-uno' },
//   { title: 'Proyecto Dos', tagline: 'Breve descripción del proyecto.', tag: 'Mobile', accent: '#ff4f6d', href: '/proyectos/proyecto-dos' },
//   { title: 'Proyecto Tres', tagline: 'Breve descripción del proyecto.', tag: 'Diseño UI', accent: '#ffb020', href: '/proyectos/proyecto-tres' },
// ];

const featuredProjects = projects.filter(p => p.classifications.includes('destacado'))
.slice(0, 3)
.map(p => ({ title: p.title, tagline: p.tagline, tag: p.techTags[0] ?? '', accent: p.accent, href: p.href! }));
---
<BaseLayout title="Tu Nombre — Portafolio" description="Desarrollador de software, proyectos y notas.">

  {latestAnnouncement && (
    <AnnouncementBanner
      tag={latestAnnouncement.data.tag}
      title={latestAnnouncement.data.title}
      description={latestAnnouncement.data.description}
      ctaLabel={latestAnnouncement.data.ctaLabel}
      ctaHref={latestAnnouncement.data.ctaHref}
      accent={latestAnnouncement.data.accent}
    />
  )}

  <section class="section">
    <div class="section-header">
      <h2>Proyectos destacados</h2>
      <a href="/proyectos" class="see-all">Ver todos →</a>
    </div>
    <div class="featured-grid">
      {featuredProjects.map((p, i) => (
        <FeaturedProjectCard
          index={i + 1}
          title={p.title}
          tagline={p.tagline}
          tag={p.tag}
          accent={p.accent}
          href={p.href}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Actividad reciente</h2>
    </div>
    <ActivityTimeline
      items={pastAnnouncements.map((a) => ({
        title: a.data.title,
        tag: a.data.tag,
        date: a.data.date,
        href: a.data.ctaHref,
        accent: a.data.accent,
      }))}
    />
  </section>
</BaseLayout>

<style lang="scss">
  .section {
    padding-block: 2rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;

    h2 { margin: 0; }

    .see-all {
      font-size: 0.85rem;
      color: var(--color-accent);
      text-decoration: none;
      &:hover { opacity: 0.8; }
    }
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
</style>