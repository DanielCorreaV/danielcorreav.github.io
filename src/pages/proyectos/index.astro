---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedProjectCard from '../../components/projects/FeaturedProjectCard.astro';
import ProjectCarousel from '../../components/projects/ProjectCarousel.astro';
import PracticeProjectCard from '../../components/projects/PracticeProjectCard.astro';
import TagFilterBar from '../../components/projects/TagFilterBar.astro';
import PracticeProjectGroup from '../../components/projects/PracticeProjectGroup.astro';
import { projects, projectGroups, statusLabels, type Project, type ProjectGroup } from '../../data/projects';

const destacados = projects.filter(p => p.classifications.includes('destacado'));
const personales = projects.filter(p => p.classifications.includes('personal'));
const practica = projects.filter(p => p.classifications.includes('practica'));

 type PracticeItem =
   | { kind: 'project'; project: Project }
   | { kind: 'group'; meta: ProjectGroup; members: Project[] };

 const practiceItems: PracticeItem[] = [];
 const seenGroups = new Set<string>();
 for (const p of practica) {
   const meta = p.group ? projectGroups[p.group] : undefined;
   if (!p.group || !meta) {
     practiceItems.push({ kind: 'project', project: p });
     continue;
   }
   if (seenGroups.has(p.group)) continue;
   seenGroups.add(p.group);
   practiceItems.push({ kind: 'group', meta, members: practica.filter(m => m.group === p.group) });
 }

const techTags = [...new Set(projects.flatMap(p => p.techTags))].sort();
const statusTagOptions = Object.entries(statusLabels).map(([value, label]) => ({ value, label }));
---
<BaseLayout title="Proyectos — Tu Nombre" description="Portafolio de proyectos: destacados, personales y de práctica.">
  <header class="page-header">
    <h1>Proyectos</h1>
    <p>Una recopilación de lo que he construido — desde productos pulidos hasta experimentos de aprendizaje.</p>
  </header>

  <TagFilterBar techTags={techTags} statusTags={statusTagOptions} />

  <section class="section" data-project-section>
    <h2>Destacados</h2>
    <div class="featured-grid">
      {destacados.map((p, i) => (
        <FeaturedProjectCard
          index={i + 1}
          title={p.title}
          tagline={p.tagline}
          tag={p.techTags[0] ?? ''}
          cover ={p.cover}
          accent={p.accent}
          href={p.href ?? p.githubUrl ?? '#'}
          tags={[...p.techTags.map(t => t.toLowerCase()), p.status, ...p.classifications].join(',')}
        />
      ))}
    </div>
  </section>

    <section class="section" data-project-section>
    <h2>Personales</h2>
   <p class="section-intro">
    Proyectos que empiezo por mi cuenta — algunos son experimentos para probar una idea o tecnología
     puntual, y otros arrancaron como prueba de concepto que todavía tengo planeado retomar y llevar
     más lejos.
   </p>
    <ProjectCarousel
      projects={personales.map(p => ({
        title: p.title, tagline: p.tagline, accent: p.accent,
        cover: p.cover, href: p.href ?? p.githubUrl ?? '#',
        techTags: p.techTags, status: p.status, classifications: p.classifications,
        description: p.description, statusLabel: statusLabels[p.status],
      }))}
    />
  </section>

  <section class="section" data-project-section>
    <h2>Práctica y experimentos</h2>
    <p class="section-intro">
      Estos proyectos son experimentales — hechos para probar una tecnología, cumplir con una tarea
      universitaria, o simplemente aprender haciendo. Muchos son funcionales pero no están pulidos
      a nivel visual ni de producto.
    </p>
    <div class="practice-list">
      {practiceItems.map(item =>
       item.kind === 'group' ? (
         <PracticeProjectGroup
           title={item.meta.title}
           description={item.meta.description}
           accent={item.meta.accent}
           members={item.members}
         />
       ) : (
         <PracticeProjectCard
           title={item.project.title}
           description={item.project.description}
           cover={item.project.cover}
           accent={item.project.accent}
           techTags={item.project.techTags}
           status={statusLabels[item.project.status]}
           classifications={item.project.classifications}
           githubUrl={item.project.githubUrl}
           liveUrl={item.project.liveUrl}
         />
       )
     )}
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .page-header {
    padding-block: 2.5rem 1.5rem;
    h1 { margin: 0 0 0.5rem; font-size: 2rem; }
    p { opacity: 0.7; max-width: 40ch; margin: 0; }
  }
  .section {
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-border);
    &:first-of-type { border-top: none; }
    &.is-empty { display: none; }
    h2 { margin: 0 0 1.25rem; }
  }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
  .section-intro { opacity: 0.7; max-width: 60ch; margin: 0 0 1.5rem; font-size: 0.9rem; }
  .practice-list { display: flex; flex-direction: column; gap: 1rem; }
</style>